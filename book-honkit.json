{
  "title": "智慧水利平台架构与开发",
  "description": "为水利专业本科大三年级学生设计的智慧水利平台架构与开发教材",
  "author": "教材编写组",
  "language": "zh-hans",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "-sharing",
    "sharing-plus",
    "expandable-chapters",
    "chapter-fold",
    "splitter",
    "code",
    "copy-code-button",
    "anchor-navigation-ex",
    "tbfed-pagefooter",
    "-prism",
    "highlight",
    "katex",
    "search-pro",
    "page-toc-button",
    "back-to-top-button",
    "advanced-emoji"
  ],
  "pluginsConfig": {
    "tbfed-pagefooter": {
      "copyright": "Copyright &copy; 2025 智慧水利平台架构与开发教材编写组",
      "modify_label": "最后更新时间：",
      "modify_format": "YYYY-MM-DD HH:mm:ss"
    },
    "sharing": {
      "douban": false,
      "facebook": false,
      "google": false,
      "hatenaBookmark": false,
      "instapaper": false,
      "line": false,
      "linkedin": true,
      "messenger": false,
      "pocket": false,
      "qq": true,
      "qzone": true,
      "stumbleupon": false,
      "twitter": false,
      "viber": false,
      "vk": false,
      "weibo": true,
      "whatsapp": false,
      "all": [
        "weibo", "qq", "qzone", "linkedin"
      ]
    },
    "theme-default": {
      "showLevel": true,
      "styles": {
        "website": "styles/website.css",
        "ebook": "styles/ebook.css",
        "pdf": "styles/pdf.css",
        "mobi": "styles/mobi.css",
        "epub": "styles/epub.css"
      }
    },
    "anchor-navigation-ex": {
      "showLevel": false,
      "associatedWithSummary": true,
      "printLog": false,
      "multipleH1": true,
      "mode": "float",
      "showGoTop": true,
      "float": {
        "floatIcon": "fa fa-navicon",
        "showLevelIcon": false,
        "level1Icon": "fa fa-hand-o-right",
        "level2Icon": "fa fa-hand-o-right",
        "level3Icon": "fa fa-hand-o-right"
      }
    },
    "page-toc-button": {
      "maxTocDepth": 2,
      "minTocSize": 2
    }
  },
  "variables": {
    "version": "1.0.0",
    "buildTime": "2025年1月"
  }
} 