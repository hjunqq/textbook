{
    "project_name": "现代软件工程技术教材",
    "input_format": "markdown",
    "output_format": "pdf",
    "template_dir": "../LaTeX模板",
    "output_dir": "输出",
    "source_encoding": "utf-8",
    "latex_engine": "xelatex",
    "pandoc_options": [
        "--toc",
        "--number-sections", 
        "--standalone",
        "--highlight-style=tango",
        "--toc-depth=3"
    ],
    "document_class_options": {
        "documentclass": "ctexbook",
        "geometry": "margin=2.5cm",
        "fontsize": "12pt",
        "linestretch": "1.5"
    },
    "chapters": [
        "第一章 软件工程概述/1.1 软件工程基础.md",
        "第一章 软件工程概述/1.2 开发方法论.md",
        "第一章 软件工程概述/本章小结.md",
        "第二章 需求分析/2.1 需求获取.md",
        "第二章 需求分析/2.2 需求建模.md",
        "第二章 需求分析/本章小结.md"
    ],
    "preprocessing": {
        "fix_encoding": true,
        "standardize_format": true,
        "optimize_images": true,
        "fix_code_blocks": true,
        "add_chapter_numbers": true
    },
    "postprocessing": {
        "optimize_latex": true,
        "fix_chinese_fonts": true,
        "add_listings_config": true,
        "beautify_layout": true,
        "add_custom_commands": true
    },
    "quality_standards": {
        "min_chapter_words": 1500,
        "max_line_length": 100,
        "required_sections": ["学习目标", "本章小结", "思考题"],
        "code_quality_check": true
    },
    "output_formats": {
        "pdf": {
            "compile_times": 3,
            "include_toc": true,
            "include_index": false
        },
        "docx": {
            "reference_doc": null,
            "preserve_formatting": true
        },
        "latex": {
            "keep_intermediate": true,
            "optimize_code": true
        }
    }
}
