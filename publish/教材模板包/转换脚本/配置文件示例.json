{
    "input_format": "markdown",
    "output_format": "pdf",
    "template_dir": "../LaTeX模板",
    "output_dir": "../输出",
    "source_encoding": "utf-8",
    "latex_engine": "xelatex",
    "pandoc_options": [
        "--toc",
        "--number-sections"
    ],
    "chapters": [],
    "preprocessing": {
        "fix_encoding": true,
        "standardize_format": true,
        "optimize_images": true,
        "fix_code_blocks": true,
        "remove_emojis": true
    },
    "postprocessing": {
        "optimize_latex": true,
        "fix_chinese_fonts": true,
        "add_listings_config": true,
        "beautify_layout": true,
        "fix_document_structure": true
    },
    "image_settings": {
        "unified_directory": "images",
        "supported_formats": [".png", ".jpg", ".jpeg", ".gif", ".svg", ".pdf"],
        "preserve_chapter_structure": true
    },
    "latex_settings": {
        "document_class": "book",
        "font_size": "12pt",
        "paper_size": "a4paper",
        "chinese_font_main": "SimSun",
        "chinese_font_sans": "SimHei",
        "chinese_font_mono": "FangSong"
    }
}