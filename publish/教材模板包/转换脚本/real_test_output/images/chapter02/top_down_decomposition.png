<svg width="500" height="400" xmlns="http://www.w3.org/2000/svg">
  <!-- 背景 -->
  <rect width="500" height="400" fill="#f8f9fa"/>
  
  <!-- 标题 -->
  <text x="250" y="25" text-anchor="middle" font-family="Arial" font-size="16" font-weight="bold" fill="#333">自顶向下函数分解示意图</text>
  
  <!-- 顶层函数 -->
  <rect x="175" y="50" width="150" height="40" fill="#2196f3" stroke="#1976d2" stroke-width="2" rx="5"/>
  <text x="250" y="75" text-anchor="middle" font-family="Arial" font-size="12" fill="white" font-weight="bold">主函数 F</text>
  
  <!-- 箭头1 -->
  <line x1="250" y1="90" x2="250" y2="120" stroke="#666" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- 第二层函数 -->
  <rect x="50" y="130" width="120" height="35" fill="#4caf50" stroke="#388e3c" stroke-width="2" rx="5"/>
  <text x="110" y="152" text-anchor="middle" font-family="Arial" font-size="11" fill="white">子函数 F1</text>
  
  <rect x="190" y="130" width="120" height="35" fill="#4caf50" stroke="#388e3c" stroke-width="2" rx="5"/>
  <text x="250" y="152" text-anchor="middle" font-family="Arial" font-size="11" fill="white">子函数 F2</text>
  
  <rect x="330" y="130" width="120" height="35" fill="#4caf50" stroke="#388e3c" stroke-width="2" rx="5"/>
  <text x="390" y="152" text-anchor="middle" font-family="Arial" font-size="11" fill="white">子函数 F3</text>
  
  <!-- 分解线 -->
  <line x1="200" y1="90" x2="110" y2="130" stroke="#666" stroke-width="1"/>
  <line x1="250" y1="90" x2="250" y2="130" stroke="#666" stroke-width="1"/>
  <line x1="300" y1="90" x2="390" y2="130" stroke="#666" stroke-width="1"/>
  
  <!-- 箭头2 -->
  <line x1="110" y1="165" x2="110" y2="190" stroke="#666" stroke-width="1" marker-end="url(#arrowhead)"/>
  <line x1="250" y1="165" x2="250" y2="190" stroke="#666" stroke-width="1" marker-end="url(#arrowhead)"/>
  <line x1="390" y1="165" x2="390" y2="190" stroke="#666" stroke-width="1" marker-end="url(#arrowhead)"/>
  
  <!-- 第三层函数 -->
  <rect x="20" y="200" width="80" height="30" fill="#ff9800" stroke="#f57c00" stroke-width="1" rx="3"/>
  <text x="60" y="218" text-anchor="middle" font-family="Arial" font-size="10" fill="white">F1.1</text>
  
  <rect x="110" y="200" width="80" height="30" fill="#ff9800" stroke="#f57c00" stroke-width="1" rx="3"/>
  <text x="150" y="218" text-anchor="middle" font-family="Arial" font-size="10" fill="white">F1.2</text>
  
  <rect x="210" y="200" width="80" height="30" fill="#ff9800" stroke="#f57c00" stroke-width="1" rx="3"/>
  <text x="250" y="218" text-anchor="middle" font-family="Arial" font-size="10" fill="white">F2.1</text>
  
  <rect x="310" y="200" width="80" height="30" fill="#ff9800" stroke="#f57c00" stroke-width="1" rx="3"/>
  <text x="350" y="218" text-anchor="middle" font-family="Arial" font-size="10" fill="white">F3.1</text>
  
  <rect x="400" y="200" width="80" height="30" fill="#ff9800" stroke="#f57c00" stroke-width="1" rx="3"/>
  <text x="440" y="218" text-anchor="middle" font-family="Arial" font-size="10" fill="white">F3.2</text>
  
  <!-- 连接线到第三层 -->
  <line x1="85" y1="165" x2="60" y2="200" stroke="#666" stroke-width="1"/>
  <line x1="135" y1="165" x2="150" y2="200" stroke="#666" stroke-width="1"/>
  <line x1="365" y1="165" x2="350" y2="200" stroke="#666" stroke-width="1"/>
  <line x1="415" y1="165" x2="440" y2="200" stroke="#666" stroke-width="1"/>
  
  <!-- 箭头3 -->
  <line x1="150" y1="230" x2="150" y2="250" stroke="#666" stroke-width="1" marker-end="url(#arrowhead)"/>
  <line x1="350" y1="230" x2="350" y2="250" stroke="#666" stroke-width="1" marker-end="url(#arrowhead)"/>
  
  <!-- 第四层函数 -->
  <rect x="110" y="260" width="80" height="25" fill="#e91e63" stroke="#c2185b" stroke-width="1" rx="3"/>
  <text x="150" y="275" text-anchor="middle" font-family="Arial" font-size="9" fill="white">F1.2.1</text>
  
  <rect x="310" y="260" width="80" height="25" fill="#e91e63" stroke="#c2185b" stroke-width="1" rx="3"/>
  <text x="350" y="275" text-anchor="middle" font-family="Arial" font-size="9" fill="white">F3.1.1</text>
  
  <!-- 层次标签 -->
  <text x="15" y="75" font-family="Arial" font-size="12" fill="#666" font-weight="bold">第1层</text>
  <text x="15" y="152" font-family="Arial" font-size="12" fill="#666" font-weight="bold">第2层</text>
  <text x="15" y="218" font-family="Arial" font-size="12" fill="#666" font-weight="bold">第3层</text>
  <text x="15" y="275" font-family="Arial" font-size="12" fill="#666" font-weight="bold">第4层</text>
  
  <!-- 说明文字 -->
  <text x="250" y="320" text-anchor="middle" font-family="Arial" font-size="11" fill="#666">功能逐层分解，复杂性逐步降低</text>
  <text x="250" y="340" text-anchor="middle" font-family="Arial" font-size="10" fill="#888">从抽象到具体，从整体到局部</text>
  
  <!-- 箭头定义 -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#666"/>
    </marker>
  </defs>
</svg>