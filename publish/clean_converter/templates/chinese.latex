% 智慧水利教材 LaTeX 模板
% Chinese Textbook Template

\documentclass[UTF8,a4paper,12pt]{ctexbook}

% 基础包
\usepackage{geometry}
\usepackage{graphicx}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{amsmath}
\usepackage{amsfonts}
\usepackage{amssymb}
\usepackage{hyperref}
\usepackage{listings}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{multirow}
\usepackage{float}
\usepackage{caption}

% 页面设置
\geometry{
    top=2.5cm,
    bottom=2.5cm,
    left=3cm,
    right=2cm
}

% 中文字体设置
\setCJKmainfont{SimSun}
\setCJKsansfont{SimHei}
\setCJKmonofont{FangSong}

% 标题样式
\ctexset{
    chapter={
        format={\centering\Huge\bfseries},
        number={\chinese{chapter}},
        name={第,章},
        afterskip={30pt}
    },
    section={
        format={\Large\bfseries},
        afterskip={20pt}
    },
    subsection={
        format={\large\bfseries},
        afterskip={15pt}
    }
}

% 代码高亮设置
\lstset{
    backgroundcolor=\color{gray!10},
    basicstyle=\ttfamily\small,
    breaklines=true,
    captionpos=b,
    commentstyle=\color{green!60!black},
    escapeinside={\%*}{*)},
    keywordstyle=\color{blue},
    numbers=left,
    numbersep=10pt,
    numberstyle=\tiny\color{gray},
    showstringspaces=false,
    stringstyle=\color{orange},
    tabsize=4,
    frame=single,
    rulecolor=\color{black!30}
}

% 超链接设置
\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    filecolor=magenta,
    urlcolor=cyan,
    citecolor=red,
    bookmarksdepth=3,
    pdfinfo={
        Title={智慧水利平台架构与开发},
        Author={},
        Subject={智慧水利教材},
        Keywords={智慧水利,平台架构,软件开发}
    }
}

% 页眉页脚
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[CE]{智慧水利平台架构与开发}
\fancyhead[CO]{\leftmark}
\renewcommand{\headrulewidth}{0.4pt}

% 图表标题
\captionsetup{
    font=small,
    labelfont=bf,
    textfont=rm,
    justification=centering
}

% 自定义命令
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\filename}[1]{\texttt{#1}}

% 目录深度
\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}

% 开始文档
\begin{document}

% 标题页
\begin{titlepage}
    \centering
    \vspace*{2cm}
    
    {\Huge\bfseries 智慧水利平台架构与开发}
    
    \vspace{1cm}
    {\Large 教材}
    
    \vspace{2cm}
    
    \vfill
    
    {\large \today}
    
\end{titlepage}

% 目录
$if(toc)$
{
\hypersetup{linkcolor=black}
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
$endif$

% 正文内容
$body$

\end{document}