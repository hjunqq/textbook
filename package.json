{
  "name": "smart-water-platform-book",
  "version": "1.0.0",
  "description": "智慧水利平台架构与开发教材",
  "scripts": {
    "serve": "honkit serve",
    "build": "honkit build",
    "pdf": "honkit pdf . ./output/智慧水利平台架构与开发.pdf",
    "epub": "honkit epub . ./output/智慧水利平台架构与开发.epub",
    "mobi": "honkit mobi . ./output/智慧水利平台架构与开发.mobi",
    "clean": "rm -rf _book node_modules",
    "dev": "pnpm run serve"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourname/smart-water-platform-book.git"
  },
  "keywords": [
    "智慧水利",
    "软件开发",
    "教材",
    "HonKit"
  ],
  "author": "教材编写组",
  "license": "MIT",
  "devDependencies": {
    "gitbook-plugin-anchor-navigation-ex": "^1.0.14",
    "gitbook-plugin-chapter-fold": "^0.0.4",
    "gitbook-plugin-code": "^0.1.0",
    "gitbook-plugin-copy-code-button": "^0.0.2",
    "gitbook-plugin-expandable-chapters": "^0.2.0",
    "gitbook-plugin-highlight": "^2.0.3",
    "gitbook-plugin-katex": "^1.1.4",
    "gitbook-plugin-prism": "^2.4.0",
    "gitbook-plugin-search-pro": "^2.0.2",
    "gitbook-plugin-sharing-plus": "^0.0.2",
    "gitbook-plugin-splitter": "^0.0.8",
    "gitbook-plugin-tbfed-pagefooter": "^0.0.1",
    "honkit": "^6.0.2"
  }
